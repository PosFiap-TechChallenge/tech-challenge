# Ambiente de execucao da aplicacao
NODE_ENV=development

# Porta HTTP exposta pela API
PORT=3000

# String de conexao usada pelo Prisma Client e pelas migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techchallenge?schema=public"

# Parametros individuais do PostgreSQL (consumidos pelo docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=techchallenge

# Origens permitidas pelo CORS ("*" libera todas)
CORS_ORIGIN=*

# Segredo HMAC usado para assinar o JWT (minimo 32 caracteres).
# Gere um valor aleatorio com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Validade do token de acesso em segundos
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=techchallenge-api
JWT_AUDIENCE=techchallenge-clients

# Usuario ADMIN inicial criado por `pnpm seed:admin`
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@oficina.com
ADMIN_PASSWORD=TroqueEssaSenha123
