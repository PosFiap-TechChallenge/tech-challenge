generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Model de exemplo — existe apenas para que a primeira migration tenha conteudo.
/// Substitua por models reais conforme o dominio for modelado.
model Example {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("examples")
}
