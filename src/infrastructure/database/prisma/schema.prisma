generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papeis dos usuarios internos da oficina.
enum UserRole {
  ADMIN
  ATTENDANT
  MECHANIC

  @@map("user_role")
}

/// Usuario interno que acessa a API autenticado via JWT.
model User {
  id           String   @id @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Cliente da oficina, identificado por CPF ou CNPJ (armazenado sem mascara).
model Customer {
  id        String         @id @db.Uuid
  name      String         @db.VarChar(120)
  document  String         @unique @db.VarChar(14)
  email     String?        @db.VarChar(254)
  phone     String?        @db.VarChar(11)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  vehicles  Vehicle[]
  orders    ServiceOrder[]

  @@index([createdAt])
  @@map("customers")
}

/// Veiculo da oficina, identificado pela placa (armazenada sem mascara) e sempre vinculado a um cliente.
model Vehicle {
  id         String         @id @db.Uuid
  plate      String         @unique @db.VarChar(7)
  brand      String         @db.VarChar(80)
  model      String         @db.VarChar(100)
  year       Int
  customerId String         @map("customer_id") @db.Uuid
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders     ServiceOrder[]
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([createdAt])
  @@map("vehicles")
}

/// Item do catalogo da oficina, com preco e tempo estimado de execucao.
model Service {
  id               String             @id @db.Uuid
  name             String             @unique @db.VarChar(120)
  price            Decimal            @db.Decimal(12, 2)
  estimatedMinutes Int                @map("estimated_minutes")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  orderItems       OrderServiceItem[]

  @@index([createdAt])
  @@map("services")
}

/// Tipos de movimentacao de estoque.
enum StockMovementType {
  INITIAL
  ENTRY
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION

  @@map("stock_movement_type")
}

/// Peca (aplicada ao veiculo) ou insumo (consumido no servico).
enum PartType {
  PART
  SUPPLY

  @@map("part_type")
}

/// Unidade de medida; so UN exige quantidades inteiras.
enum MeasurementUnit {
  UN
  L
  ML
  KG
  G
  M

  @@map("measurement_unit")
}

/// Peca ou insumo e seu estoque: saldo fisico, reservado e minimo (ate 3 casas). `version` serve ao lock otimista.
model Part {
  id           String          @id @db.Uuid
  code         String          @unique @db.VarChar(40)
  name         String          @db.VarChar(120)
  type         PartType
  unit         MeasurementUnit
  unitPrice    Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity     Decimal         @db.Decimal(12, 3)
  reserved     Decimal         @default(0) @db.Decimal(12, 3)
  minimumStock Decimal         @map("minimum_stock") @db.Decimal(12, 3)
  version      Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  movements    StockMovement[]
  orderItems   OrderPartItem[]

  @@index([createdAt])
  @@map("parts")
}

/// Historico imutavel das operacoes de estoque de uma peca.
model StockMovement {
  id            String            @id @db.Uuid
  partId        String            @map("part_id") @db.Uuid
  part          Part              @relation(fields: [partId], references: [id], onDelete: Restrict)
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(12, 3)
  reservedAfter Decimal           @map("reserved_after") @db.Decimal(12, 3)
  reason        String?           @db.VarChar(255)
  createdAt     DateTime          @default(now()) @map("created_at")
  /// Ordem de gravacao: desempata movimentacoes registradas no mesmo milissegundo.
  sequence      BigInt            @default(autoincrement())

  @@index([partId, sequence])
  @@map("stock_movements")
}

/// Ciclo de vida da Ordem de Servico.
enum OrderStatus {
  RECEIVED
  IN_DIAGNOSIS
  AWAITING_APPROVAL
  IN_EXECUTION
  FINISHED
  DELIVERED

  @@map("order_status")
}

/// Situacao do orcamento enviado ao cliente.
enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("budget_status")
}

/// Ordem de Servico: veiculo do cliente, servicos, pecas e orcamento. `version` e o lock otimista.
model ServiceOrder {
  id              String              @id @db.Uuid
  customerId      String              @map("customer_id") @db.Uuid
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId       String              @map("vehicle_id") @db.Uuid
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  status          OrderStatus
  budgetStatus    BudgetStatus?       @map("budget_status")
  budgetTotal     Decimal?            @map("budget_total") @db.Decimal(12, 2)
  budgetSentAt    DateTime?           @map("budget_sent_at")
  budgetDecidedAt DateTime?           @map("budget_decided_at")
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  serviceItems    OrderServiceItem[]
  partItems       OrderPartItem[]
  statusChanges   OrderStatusChange[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@map("service_orders")
}

/// Item de Servico: nome, preco e tempo estimado sao copias do catalogo no momento da inclusao.
model OrderServiceItem {
  id               String       @id @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  order            ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId        String       @map("service_id") @db.Uuid
  service          Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  name             String       @db.VarChar(120)
  price            Decimal      @db.Decimal(12, 2)
  estimatedMinutes Int          @map("estimated_minutes")
  startedAt        DateTime?    @map("started_at")
  finishedAt       DateTime?    @map("finished_at")
  createdAt        DateTime     @map("created_at")

  @@unique([orderId, serviceId])
  @@index([serviceId])
  @@map("order_service_items")
}

/// Item de Peca: dados e preco unitario sao copias do estoque no momento da inclusao.
model OrderPartItem {
  id        String          @id @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  order     ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String          @map("part_id") @db.Uuid
  part      Part            @relation(fields: [partId], references: [id], onDelete: Restrict)
  code      String          @db.VarChar(40)
  name      String          @db.VarChar(120)
  unit      MeasurementUnit
  quantity  Decimal         @db.Decimal(12, 3)
  unitPrice Decimal         @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime        @map("created_at")

  @@unique([orderId, partId])
  @@index([partId])
  @@map("order_part_items")
}

/// Historico de status da OS; `id` crescente preserva a ordem em que ocorreram.
model OrderStatusChange {
  id         Int          @id @default(autoincrement())
  orderId    String       @map("order_id") @db.Uuid
  order      ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  occurredAt DateTime     @map("occurred_at")

  @@index([orderId])
  @@map("order_status_changes")
}
